includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - tests/Architecture/*
    tmpDir: .phpstan-cache
    ignoreErrors:
        # Opt-in trait for host applications' models; only consumed outside this package.
        -
            identifier: trait.unused
            path: src/Infrastructure/Persistence/Concerns/AtomicSoftDeletes.php
